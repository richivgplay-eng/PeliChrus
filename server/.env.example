# Copia este archivo como .env y agrega credenciales solo en el archivo local ignorado por Git.
TMDB_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_TOKEN_LIMIT=100000

# En producción, configura solo los orígenes reales del frontend.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:7357,http://127.0.0.1:7357
PORT=3000
